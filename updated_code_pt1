]

canvas_width = len(pixel_codes[0]) * PIXEL_SIZE
canvas_height = len(pixel_codes) * PIXEL_SIZE

canvas = tk.Canvas(header, width=canvas_width, height=canvas_height, bg="#E67E22", highlightthickness=0)
canvas.place(x=650, y=25)  # positioned inside header to the right of text

# Draw pixel art
for y, row in enumerate(pixel_codes):
    for x, code in enumerate(row):
        color = color_map.get(code, BACKGROUND)
        x1 = x * PIXEL_SIZE
        y1 = y * PIXEL_SIZE
        x2 = x1 + PIXEL_SIZE
        y2 = y1 + PIXEL_SIZE
        canvas.create_rectangle(x1, y1, x2, y2, fill=color, outline=color)

# -------------------- Bobbing Animation (Pixel Art Only) --------------------
direction = 1  # 1 = move down, -1 = move up
offset = 0     # current offset from starting position
amplitude = 5  # maximum pixels to move up or down

def bobbing_pixels():
    global direction, offset
    # Move all items inside the canvas
    canvas.move("all", 0, direction)
    offset += direction

    # Reverse direction if we reach the amplitude limit
    if offset >= amplitude:
        direction = -1
    elif offset <= 0:
        direction = 1

    canvas.after(100, bobbing_pixels)  # repeat every 100ms

bobbing_pixels()  # start the animation

